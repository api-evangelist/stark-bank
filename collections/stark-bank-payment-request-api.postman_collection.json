        {
          "id": "4f697e2a-43e1-4dd4-8fe3-b90a711586d2",
          "name": "List Payment Requests",
          "request": {
            "name": "List Payment Requests",
            "description": {
              "content": "Here you can list and filter payment requests created by the requesting user. We return it paged.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "payment-request"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "centerId",
                  "value": "<string>",
                  "description": "(Required) Unique ID of the targeted cost center. You can check out the cost center ID directly on its approval section on our Web Banking. Example: 5656565656565656"
                },
                {
                  "disabled": false,
                  "key": "after",
                  "value": "<date>",
                  "description": "Filter entities created after this date."
                },
                {
                  "disabled": false,
                  "key": "before",
                  "value": "<date>",
                  "description": "Filter entities created before this date."
                },
                {
                  "disabled": false,
                  "key": "cursor",
                  "value": "<string>",
                  "description": "String used to get the next batch of results. Our SDKs handle this for you."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "List of strings to filter response JSON keys. Not available in the SDKs."
                },
                {
                  "disabled": false,
                  "key": "fields",
                  "value": "<string>",
                  "description": "List of strings to filter response JSON keys. Not available in the SDKs."
                },
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "List of strings to get specific entities by ids."
                },
                {
                  "disabled": false,
                  "key": "ids",
                  "value": "<string>",
                  "description": "List of strings to get specific entities by ids."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Number of results per cursor. Max = 100."
                },
                {
                  "disabled": false,
                  "key": "sort",
                  "value": "<string>",
                  "description": "Sort order considered in the response. Options are: \"created\", \"-created\", \"updated\" and \"-updated\". \"-\" means descending order. Default is \"-created\"."
                },
                {
                  "disabled": false,
                  "key": "status",
                  "value": "<string>",
                  "description": "Filter payment requests by the specified status. Example: success"
                },
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "Filter entities that contain the specified tags."
                },
                {
                  "disabled": false,
                  "key": "tags",
                  "value": "<string>",
                  "description": "Filter entities that contain the specified tags."
                },
                {
                  "disabled": false,
                  "key": "type",
                  "value": "<string>",
                  "description": "Filters payment requests by the type inferred from the payment parameter, if it is not a dictionary. Example: boleto-payment"
                }
              ],
              "variable": []
            },
