  "item": [
    {
      "id": "30d0ca9f-717b-4243-86d6-e54b4e9b87e2",
      "name": "Payment Request",
      "description": {
        "content": "Here we will teach you how to create and manage your payment requests. The payment request is the main element of our approval flow, which can be checked out by logging into our Web Banking.\nThe requests are bound to their respective cost centers and represent requests to execute specific payments, which can be transfers, boleto payments, etc. Expect more payment options to be introduced!\n",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "58e4b058-0713-4b00-8269-122248a9d867",
          "name": "Create Payment Requests",
          "request": {
            "name": "Create Payment Requests",
            "description": {
              "content": "Use this route to create new payment requests in our Web Banking approval flow.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v2",
                "payment-request"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
