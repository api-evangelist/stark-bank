{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stark Bank Balance API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Digital-Signature",
      "value": "{{Digital-Signature}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Balance",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get the Balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.starkbank.com/v2/balance"
          },
          "docs": "Get the current balance in your workspace."
        }
      ]
    }
  ],
  "bundled": true
}