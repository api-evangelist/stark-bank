  "item": [
    {
      "id": "4287d18c-1eb0-4c54-9d27-5f07982a9a68",
      "name": "Dynamic Brcode",
      "description": {
        "content": "Note:This is a basic Pix QR Code solution for one time payment. For a complete Pix QR Code receivable, check the Invoice resource.\nWhen a Dynamic Brcode is paid, a Deposit is created with the tags parameter containing the string \"dynamic-brcode/\" followed by the Dynamic Brcode's uuid \"dynamic-brcode/{uuid}\" for conciliation.\n",
        "type": "text/plain"
      },
