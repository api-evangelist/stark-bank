          "name": "Create Dynamic Brcodes",
          "request": {
            "name": "Create Dynamic Brcodes",
            "description": {
              "content": "Use this route to create up to 100 new dynamic brcodes at a time.",
              "type": "text/plain"
            },
            "url": {
