{
  "opencollection": "1.0.0",
  "info": {
    "name": "Stark Bank Balance Dynamic Brcode API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Digital-Signature",
      "value": "{{Digital-Signature}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Dynamic Brcode",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Dynamic Brcodes",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.starkbank.com/v2/dynamic-brcode",
            "params": [
              {
                "name": "after",
                "value": "",
                "type": "query",
                "description": "Filter entities created after this date."
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Filter entities created before this date."
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "String used to get the next batch of results. Our SDKs handle this for you."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of results per cursor. Max = 100."
              },
              {
                "name": "tags",
                "value": "",
                "type": "query",
                "description": "Filter entities that contain the specified tags."
              },
              {
                "name": "uuids",
                "value": "",
                "type": "query",
                "description": "list of uuids to filter retrieved objects."
              }
            ]
          },
          "docs": "Get a list of brcodes in chunks of at most 100. If you need smaller chunks, use the limit parameter."
        },
        {
          "info": {
            "name": "Create Dynamic Brcodes",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.starkbank.com/v2/dynamic-brcode",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Use this route to create up to 100 new dynamic brcodes at a time."
        },
        {
          "info": {
            "name": "Get a Dynamic Brcode",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.starkbank.com/v2/dynamic-brcode/:uuid",
            "params": [
              {
                "name": "uuid",
                "value": "",
                "type": "path",
                "description": "Uuid of the brcode entity."
              },
              {
                "name": "fields",
                "value": "",
                "type": "query",
                "description": "List of strings to filter response JSON keys. Not available in the SDKs."
              }
            ]
          },
          "docs": "Get a single dynamic brcode by its uuid."
        }
      ]
    }
  ],
  "bundled": true
}